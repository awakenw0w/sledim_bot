# -------------------------------------------------------
# Скопируйте этот файл в .env и заполните свои значения:
#   cp .env.example .env
# -------------------------------------------------------

# Токен Telegram-бота (получить у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# VK API токен.
# Способ 1 (рекомендуется): Создайте standalone-приложение на https://vk.com/apps?act=manage
#   → Настройки → Сервисный ключ доступа (не требует авторизации пользователя).
#   Однако сервисный ключ НЕ возвращает online-статус — нужен токен пользователя.
# Способ 2 (для получения online-статусов): Авторизуйтесь как пользователь.
#   Временный токен можно получить через https://vkhost.github.io/ (выберите нужные права)
#   или через Implicit Flow вашего приложения (права: friends, offline).
VK_ACCESS_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Версия VK API (не меняйте без необходимости)
VK_API_VERSION=5.131

# Путь к файлу SQLite базы данных
DB_PATH=bot_database.db

# Интервал проверки онлайн-статуса в секундах
ONLINE_CHECK_INTERVAL=60

# Интервал проверки друзей, аватарки, статуса профиля и остальных не-онлайн данных
PROFILE_CHECK_INTERVAL=7200

# Обязательная подписка на Telegram-канал.
# Для приватного канала нужен именно числовой chat_id канала в формате -100...
REQUIRED_CHANNEL_LINK=
REQUIRED_CHANNEL_ID=
